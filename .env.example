# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Your live address, used for sign-in links and sharing previews
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Optional: the weekly email (see the README)
# RESEND_API_KEY=
# EMAIL_FROM=Covvvvvers <weekly@your-domain.com>
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# Optional: show "Continue with Google" on the sign-in page
# NEXT_PUBLIC_ENABLE_GOOGLE=true
